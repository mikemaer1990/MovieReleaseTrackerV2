<% if (showControls) { %>
<div class="module-controls">
  <div class="controls-content">
    <!-- Modern Sort Controls -->
    <div class="filter-controls">
      <form method="GET" action="<%= actionUrl %>" class="filter-form" id="sort-form">
        <div class="sort-controls">
          <div class="segmented-control" role="radiogroup" aria-label="Sort options">
            <% sortOptions.forEach((option, index) => { %>
              <div class="segmented-option">
                <input
                  type="radio"
                  id="sort-<%= option.value %>"
                  name="sort"
                  value="<%= option.value %>"
                  <%= sortBy === option.value ? 'checked' : '' %>
                  aria-describedby="sort-description"
                >
                <label for="sort-<%= option.value %>">
                  <% if (option.value === 'popularity') { %>
                    <span class="icon">⭐</span>
                  <% } else if (option.value.includes('release_date_asc') || option.value === 'soonest') { %>
                    <span class="icon">↗️</span>
                  <% } else if (option.value.includes('release_date_desc') || option.value === 'furthest') { %>
                    <span class="icon">↙️</span>
                  <% } else if (option.value === 'newest') { %>
                    <span class="icon">🆕</span>
                  <% } %>
                  <%= option.label %>
                </label>
              </div>
            <% }) %>
          </div>
        </div>
        <div id="sort-description" class="sr-only">
          Select a sorting option to reorder the movie results
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>